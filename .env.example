# Cortensor Portal API Key (From https://portal.cortensor.network)
export CORTENSOR_API_KEY="ct-live-your_api_key_from_portal"

# Cortensor API Endpoint (Defaults to official v1 endpoint)
export CORTENSOR_BASE_URL="https://api.cortensor.network/v1"

# Validator Node Identifier & Epoch
export CORTENSOR_VALIDATOR_ID="val-cortensor-node-01"
export CORTENSOR_EPOCH="1"

# HMAC Secret Key for Cryptographic Attestation Receipts
export CORTENSOR_SECRET_KEY="cortensor_subnet_secret_key_2026"
